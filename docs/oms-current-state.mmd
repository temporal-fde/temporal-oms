  CommerceWebhook --> TopicCommerce --> OMSUpdatePayment --> WriteToDB --> HasAllData
  HasAllData -- "Yes" --> TopicEnrich --> EnrichAPI --> DB1
  HasAllData -- "No" --> TopicOrdersDlq --> DB2

  PaymentProcessor -- "publishes" --> TopicPayments
  TopicPayments --> OMSUpdatePayment

  CronProcessOrders -- "publishes *" --> TopicOrdersValidate
  TopicOrdersValidate --> OMSValidate --> OrderValid
  OrderValid -- "Yes" --> TopicOrdersAllocate --> AllocationService
  OrderValid -- "No" --> OrderCorrectionApp

  TopicEnrich --> OMSTransform --> OrderOK
  OrderOK -- "Yes" --> WriteToDB
  OrderOK -- "No" --> TopicOrdersDlq