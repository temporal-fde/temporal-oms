flowchart TD

  subgraph Ext["External Systems"]
    CA["Commerce App<br/>webhook + API"]
    PP["Payment Processor"]
    Carrier["Carrier<br/>webhook"]
  end

  subgraph AppsNS["Temporal — Apps Namespace"]
    AO["apps.Order<br/>Collects submitOrder + capturePayment inputs<br/>Orchestrates processing and fulfillment via Nexus"]
  end

  subgraph ProcNS["Temporal — Processing Namespace"]
    PO["processing.Order<br/>Validate order via Commerce App<br/>Enrich items via PIMS<br/>Confirm payment via Payment Processor"]
  end

  subgraph FulfillNS["Temporal — Fulfillment Namespace  (Java)"]
    FO["fulfillment.Order<br/>validateOrder Update — verify shipping address early<br/>holdItems — eager inventory hold while processing runs<br/>fulfillOrder Update — reserve inventory<br/>recommendShippingOption — call ShippingAgent via Nexus<br/>printShippingLabel + deductInventory — concurrent<br/>await notifyDeliveryStatus Signal"]
    Attrs[("margin_leak<br/>sla_breach_days<br/>Search Attributes")]
  end

  subgraph AgentsNS["Temporal — Agents Namespace  (Python)"]
    SA["ShippingAgent<br/>WorkflowID: customer_id  —  long-running per customer<br/>ReAct agentic loop  —  30 min result cache<br/>recommend_shipping_option Update"]
    AT["Activity Tools<br/>lookup_inventory_address  ·  get_carrier_rates<br/>get_location_events  ·  find_alternate_warehouse"]
  end

  EA[("enablements-api<br/>Integration abstraction layer<br/>Shipping  ·  Inventory  ·  Commerce App  ·  PIMS<br/>fixture-backed for workshops  —  live credentials for production")]

  CA -->|"submitOrder [Update]"| AO
  PP -->|"capturePayment [Update]"| AO

  AO -->|"processOrder [Nexus]"| PO
  PO -.->|"GetProcessOrderStateResponse<br/>enriched items"| AO
  PO -->|"validateOrder + enrichOrder<br/>Activities"| EA

  AO -->|"validateOrder [Nexus UpdateWithStart]<br/>fires concurrent with processOrder"| FO
  AO -->|"fulfillOrder [Nexus Update — ACCEPTED]<br/>after processOrder completes"| FO

  FO -->|"verifyAddress  holdItems  reserveItems<br/>deductInventory  releaseHold  printShippingLabel<br/>Activities via fulfillment-carriers + InventoryService Nexus"| EA

  FO -->|"recommendShippingOption<br/>[Nexus Update]"| SA
  SA -.->|"ShippingRecommendation<br/>RecommendationOutcome + ShippingOptions"| FO

  SA --> AT
  AT -->|"all tool calls route through"| EA

  Carrier -->|"notifyDeliveryStatus [Signal]<br/>DELIVERED or CANCELED"| FO
  FO --- Attrs

