flowchart LR
  OrderInput["Order Input<br/>Commerce webhook"]
  PaymentInput["Payment Input<br/>Payment webhook"]
  AppsOrder["apps.Order<br/>UpdateWithStart<br/>waits for both inputs"]
  ProcessingOrder["processing.Order<br/>validate + enrich"]
  SupportTeam["SupportTeam<br/>invalid order correction"]
  Kafka["Kafka: order-fulfillment<br/>FulfillOrderRequest message"]
  Boundary["V1 boundary<br/>message handoff<br/>not durable fulfillment"]

  OrderInput -->|"submitOrder update"| AppsOrder
  PaymentInput -->|"capturePayment update"| AppsOrder
  AppsOrder -->|"processOrder Nexus call"| ProcessingOrder
  ProcessingOrder -->|"if invalid"| SupportTeam
  SupportTeam -->|"manual correction complete"| ProcessingOrder
  ProcessingOrder ==>|"publish fulfillment handoff"| Kafka
  Kafka --> Boundary

  AppsNote["Order + payment<br/>can arrive in either order"]
  ProcessingNote["Processing owns<br/>validation + enrichment"]
  GapNote["Workshop starting gap:<br/>no durable fulfillment lifecycle"]

  AppsNote -.-> AppsOrder
  ProcessingNote -.-> ProcessingOrder
  GapNote -.-> Boundary

